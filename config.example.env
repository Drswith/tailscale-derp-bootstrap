# Copy to config.env, edit, and keep this file out of Git.
PUBLIC_IPV4="203.0.113.10"
ACME_EMAIL="you@example.com"
EXPECTED_TAILNET="example.com"
TS_HOSTNAME="derp-example"

# Optional: place a one-use, non-ephemeral Auth key or OAuth client secret here
# (mode 0600), or leave empty to complete tailscale up interactively. A
# credential at this default path is removed after successful enrollment.
TS_AUTH_KEY_FILE="/run/derp-bootstrap/auth.key"
# Optional comma-separated tags. Required when TS_AUTH_KEY_FILE contains an
# OAuth client secret; that secret can include ?ephemeral=false&preauthorized=true.
TS_ADVERTISE_TAGS=""

DERP_PORT="443"
STUN_PORT="3478"
REGION_ID="900"
REGION_CODE="example-derp"
REGION_NAME="Example DERP"
