# Copy to docker/config.env and keep out of Git.
PUBLIC_IPV4="203.0.113.10"
ACME_EMAIL="you@example.com"
EXPECTED_TAILNET="example.com"
TS_HOSTNAME="derp-example"

# interactive: browser login URL appears in container logs.
# authkey: put a one-use key in docker/secrets/auth.key with mode 0600.
AUTH_MODE="interactive"

DERP_PORT="52625"
STUN_PORT="3478"
REGION_ID="900"
REGION_CODE="example-derp"
REGION_NAME="Example DERP"
